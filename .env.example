# Copy this file to .env before running docker-compose (docker-compose reads .env automatically).
# These are local/dev defaults only — never commit a real .env file.

POSTGRES_USER=cashflow
POSTGRES_PASSWORD=cashflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
LEDGER_DB_NAME=ledger_db
CONSOLIDATION_DB_NAME=consolidation_db

REDIS_HOST=redis
REDIS_PORT=6379

# Shared secret both services validate on the X-API-Key header (see docs/05-security.md).
API_KEY=local-dev-key-change-me

# Consolidation service load-shedding: max concurrent requests before returning 503.
CONSOLIDATION_MAX_CONCURRENCY=50

# Allowed CORS origins, comma-separated. Empty (the default) denies all cross-origin access —
# there is no browser client in this challenge. Example: CORS_ORIGINS=["http://localhost:3000"]
# CORS_ORIGINS=[]
